---
import Hero from "../components/Hero.astro";
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Layout>
	<Hero hero="/img/blog-index.jpg" title="Latest Stories" />
	<div class="posts">
		{
			posts.map((p) => (
				<a class="post" href={`/blog/${p.id}`}>
					<div>
						<span class="post-title">{p.data.title}</span> •{" "}
						<span class="post-date">{p.data.date.toLocaleDateString()}</span>
					</div>
					<p>{p.data.description}</p>
				</a>
			))
		}
	</div>
</Layout>

<style>
	.posts {
		margin-block: 2rem;
		width: 100%;
		max-width: 960px;
		margin-inline: auto;
		display: grid;
		gap: 1rem;
	}
	.post {
		border-radius: 1rem;
		padding: 2rem;
		background-color: oklch(from var(--primary) 0.98 0.05 h);
		transition:
			color 0.2s ease,
			box-shadow 0.2s ease;
		box-shadow: 5px 5px 10px oklch(from var(--primary) 0.98 0.05 h);
	}
	.post:hover {
		background-color: oklch(from var(--primary) 0.97 0.05 h);
		box-shadow: 2px 2px 5px oklch(from var(--primary) 0.97 0.05 h);
	}
	.post-title {
		font-weight: 600;
		font-size: 1.5rem;
	}
	@media (min-width: 640px) {
		.posts {
			grid-template-columns: 1fr 1fr;
		}
	}
</style>
