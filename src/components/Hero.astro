---
const { hero, title, subtitle } = Astro.props;
---

<div class="hero">
  <div class="text">
    <h1>{title}</h1>
    <h2>{subtitle}</h2>
  </div>
  <img src={hero} alt="" />
</div>

<style>
  .hero {
    position: relative;
    height: 50vh;
  }
  img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    position: absolute;
    top: 0;
    left: 0;
  }
  .text {
    display: flex;
    flex-direction: column;
    justify-content: center;
    height: 100%;
    max-width: 960px;
    margin-inline: auto;
    padding-inline: 1rem;
    position: relative;
    z-index: 1;
  }
  h1,
  h2 {
    color: white;
    text-shadow: 3px 3px 5px rgba(0 0 0 / 0.5);
  }
  h1 {
    font-size: 3rem;
  }
  h2 {
    font-size: 2rem;
  }
</style>
