---
const { id, title, date, description } = Astro.props;
---

<a class="post" href={`/blog/${id}`}>
  <div>
    <span class="post-title">{title}</span> •{" "}
    <span class="post-date">{date.toLocaleDateString()}</span>
  </div>
  <p>{description}</p>
</a>

<style>
  .post {
    border-radius: 1rem;
    padding: 2rem;
    background-color: oklch(from var(--primary) 0.98 0.05 h);
    transition:
      color 0.2s ease,
      box-shadow 0.2s ease;
    box-shadow: 5px 5px 10px oklch(from var(--primary) 0.98 0.05 h);
  }
  .post:hover {
    background-color: oklch(from var(--primary) 0.97 0.05 h);
    box-shadow: 2px 2px 5px oklch(from var(--primary) 0.97 0.05 h);
  }
  .post-title {
    font-weight: 600;
    font-size: 1.5rem;
  }
</style>
